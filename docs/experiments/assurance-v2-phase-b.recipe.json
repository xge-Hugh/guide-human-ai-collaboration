{
  "schema_version": 1,
  "experiment_id": "assurance-v2-phase-b-stage3",
  "formal_execution_enabled": true,
  "sources": {
    "generation": "assurance-v2-phase-b-generation.json",
    "variants": "assurance-v2-phase-b-variants.zh-CN.json",
    "rubrics": "assurance-v2-phase-b-rubrics.json"
  },
  "selection": {
    "cases": ["p003", "p004", "p005", "p006", "p007", "p008", "p009", "p011", "p012", "p013"],
    "variants": ["B0", "B1", "B2"]
  },
  "renderers": {
    "generator": "phase-b-formal-generator-zh-cn-v1",
    "grader": "phase-b-direct-grader-zh-cn-v1-candidate"
  },
  "schedule": {
    "repetitions": 3,
    "variant_order_by_repetition": [
      ["B0", "B1", "B2"],
      ["B1", "B2", "B0"],
      ["B2", "B0", "B1"]
    ],
    "operational_tranches": {
      "tranche_1": {"repetitions": [1]},
      "tranche_2": {"repetitions": [2, 3]},
      "allowed_pause_reasons": [
        "schema_or_transport_failure",
        "secret_leak",
        "unexpected_provider_response",
        "finish_reason_length",
        "configuration_or_provenance_mismatch",
        "human_approved_cost_limit_exceeded"
      ],
      "performance_driven_redesign_between_tranches_forbidden": true
    }
  },
  "instructions": {
    "generator_base": "你是当前协作中的 AI 助手。请根据提供的前置上下文，\n自然回应用户当前消息。"
  },
  "parameters": {
    "generator": {"thinking": {"type": "enabled"}, "max_tokens": 65536, "stream": false},
    "grader": {"thinking": {"type": "enabled"}, "max_tokens": 32768, "stream": false}
  },
  "timeouts_seconds": {
    "generator": 900,
    "grader": 600
  },
  "grading": {
    "policy_id": "phase-b-axis-policy-v1",
    "axes": {
      "applicability": ["applicable", "not_applicable", "uncertain"],
      "applicability_basis": "non-empty string",
      "timing": ["on_time", "late_recoverable", "late_contaminated", "too_late", "not_applicable"],
      "satisfaction": ["satisfied", "partial", "unsatisfied", "not_applicable"],
      "human_compensation_needed": ["yes", "no", "unclear"],
      "over_trigger_cost": ["none", "low", "material"],
      "notes": "string"
    },
    "conditional_rule": "timing and satisfaction are not_applicable exactly when applicability is not_applicable",
    "output_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "applicability_basis", "timing", "satisfaction", "human_compensation_needed", "over_trigger_cost", "notes"],
      "properties": {
        "applicability": {"enum": ["applicable", "not_applicable", "uncertain"]},
        "applicability_basis": {"type": "string", "minLength": 1},
        "timing": {"enum": ["on_time", "late_recoverable", "late_contaminated", "too_late", "not_applicable"]},
        "satisfaction": {"enum": ["satisfied", "partial", "unsatisfied", "not_applicable"]},
        "human_compensation_needed": {"enum": ["yes", "no", "unclear"]},
        "over_trigger_cost": {"enum": ["none", "low", "material"]},
        "notes": {"type": "string"}
      },
      "allOf": [{
        "if": {"properties": {"applicability": {"const": "not_applicable"}}},
        "then": {"properties": {"timing": {"const": "not_applicable"}, "satisfaction": {"const": "not_applicable"}}},
        "else": {
          "properties": {
            "timing": {"not": {"const": "not_applicable"}},
            "satisfaction": {"not": {"const": "not_applicable"}}
          }
        }
      }]
    },
    "interpretation": {
      "not_a_total_score": true,
      "unresolved_grades_not_favorable": true,
      "preserve_original_grader_judgments_after_adjudication": true,
      "automatic_variant_winner_or_pass_fail": false
    }
  },
  "output_root": "../../../.assurance-eval-results"
}
